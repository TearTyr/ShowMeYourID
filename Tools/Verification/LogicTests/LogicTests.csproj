<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless logic test runner: executes the pure-C# gameplay logic
       (rules, generation, progression, endings, save format) for real. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SMYID.LogicTests</AssemblyName>
    <RootNamespace>SMYID.Tests</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>0169;0414;0649;0067;0108</NoWarn>
    <StartupObject>SMYID.Tests.TestRunner</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UnityStubs/**/*.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/GameLogic/**/*.cs" />
    <Compile Include="Tests.cs" />
  </ItemGroup>
</Project>
