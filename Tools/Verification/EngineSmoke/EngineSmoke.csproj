<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine smoke tests: boots the whole game through the real GameBootstrap against the
       Unity stubs (synchronous coroutines), then drives menus, shifts, checkpoint verdicts,
       exploration, clues, anomalies, settings, saves and endings headlessly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SMYID.EngineSmoke</AssemblyName>
    <RootNamespace>SMYID.Smoke</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>0169;0414;0649;0067;0108</NoWarn>
    <StartupObject>SMYID.Smoke.SmokeRunner</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UnityStubs/**/*.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/**/*.cs" />
    <Compile Include="EngineSmoke.cs" />
  </ItemGroup>
</Project>
