<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless NEW GAME flow check: boots the menu, clicks NEW GAME, simulates the scene
       load the way Unity's Awake would, clicks through the intro, and prints the [Flow]
       chain plus the Symptom-0 structural proofs. Not a unit test suite: a diagnostic. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FlowCheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>0169;0414;0649;0067;0108</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Verification/UnityStubs/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
