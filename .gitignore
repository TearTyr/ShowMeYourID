# Verification tooling build output (hand-maintained csproj files are tracked)
Tools/**/bin/
Tools/**/obj/

# Generated visual-check output (Tools/Preview/render_map_preview.py, FlowCheck --dump-drawer)
/preview/

# Source art (PSDs, full size exports, 150+ MB). The game only loads the cut copies under
# Assets/_Project/Resources/Art, made by the Tools/prep_*.py scripts.
/Art/

# Python tool leftovers
__pycache__/
*.pyc

# Claude Code local files
/.claude/

# OS
.DS_Store
Thumbs.db

# Unity crash reports
sysinfo.txt
*.stackdump
crashlytics-build.properties
